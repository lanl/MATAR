@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@MATAR_ENABLE_KOKKOS@)
    find_dependency(Kokkos)
endif()
if(@MATAR_ENABLE_MPI@)
    find_dependency(MPI COMPONENTS CXX)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/MatarTargets.cmake")

# Older consumers link against plain `matar` rather than matar::matar.
if(NOT TARGET matar)
    add_library(matar ALIAS matar::matar)
endif()

check_required_components(Matar)
